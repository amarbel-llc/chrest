# vim: set ft=toml

[hooks]
pre-merge = "just"
pre-commit = "conformist-pre-commit"

# Publishes the Firefox extension to AMO via `just deploy-amo`; the guards
# (version already on AMO / already submitted, credentials missing) live in
# that recipe, which is also where the contract is documented. Output goes to
# a log file because spinclass's merge response relays only an exit status.
[[post-merge]]
name = "amo"
command = """
[ "$SPINCLASS_MERGE_PUSHED" = 1 ] || exit 0
log="${TMPDIR:-/tmp}/chrest-post-merge-deploy-amo.log"
{
  echo "=== post-merge deploy-amo $(date -u +%FT%TZ) sha=${SPINCLASS_MERGED_SHA:-unknown} ==="
  nix develop -c just deploy-amo
} >>"$log" 2>&1
rc=$?
echo "post-merge amo: exit $rc (log: $log)"
exit "$rc"
"""
